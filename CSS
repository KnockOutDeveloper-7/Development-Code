/* KnockOut - shared styles */
:root {
  --purple-950: #0b0333;
  --purple-900: #12064d;
  --purple-800: #1c0a78;
  --purple-700: #2a0fa8;
  --purple-600: #3d14d1;
  --purple-500: #5a22f0;
  --gold: #ffd21a;
  --gold-dark: #f5a400;
  --red: #e0201c;
  --green: #22c55e;
  --white: #ffffff;
  --text-muted: #c9c2f2;
  --border: rgba(255, 255, 255, 0.1);
  --radius: 18px;
  --max-width: 1180px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: "Poppins", system-ui, sans-serif;
  background: var(--purple-900);
  color: var(--white);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main { flex: 1; }

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }

.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 20px;
}

/* ---------- Header ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(18, 6, 77, 0.88);
  backdrop-filter: blur(10px);
  border-bottom: 2px solid rgba(255, 210, 26, 0.25);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 72px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  font-size: 1.5rem;
  color: var(--gold);
  text-shadow: 2px 2px 0 var(--purple-950);
}

.brand img { width: 42px; height: 42px; border-radius: 10px; }

.nav-menu {
  display: flex;
  align-items: center;
  gap: 26px;
}

.nav-links { display: flex; gap: 24px; list-style: none; }

.nav-links a {
  font-weight: 600;
  color: var(--text-muted);
  transition: color 0.2s;
}

.nav-links a:hover,
.nav-links a.active { color: var(--gold); }

.nav-actions { display: flex; align-items: center; gap: 12px; }

.lang-select {
  background: var(--purple-800);
  color: var(--white);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 8px 12px;
  font: inherit;
  font-size: 0.9rem;
  cursor: pointer;
}

.nav-toggle {
  display: none;
  background: none;
  border: none;
  color: var(--white);
  font-size: 1.8rem;
  cursor: pointer;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 30px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
}

.btn:hover { transform: translateY(-2px); }

.btn-sm { padding: 9px 20px; font-size: 0.9rem; }

.btn-primary {
  background: linear-gradient(180deg, var(--gold), var(--gold-dark));
  color: var(--purple-950);
  box-shadow: 0 6px 20px rgba(255, 210, 26, 0.3);
}

.btn-outline {
  border: 2px solid var(--white);
  color: var(--white);
  background: transparent;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
}

/* ---------- Sections ---------- */
section { padding: 80px 0; }

.alt-bg { background: var(--purple-800); }

.section-title {
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 900;
  color: var(--gold);
  text-align: center;
  line-height: 1.2;
  margin-bottom: 10px;
}

.section-subtitle {
  text-align: center;
  color: var(--text-muted);
  margin-bottom: 44px;
}

.page-hero {
  background: radial-gradient(ellipse at 50% 0%, var(--purple-600) 0%, var(--purple-900) 70%);
  padding: 60px 0 40px;
  text-align: center;
}

.page-hero h1 {
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 900;
  color: var(--gold);
  line-height: 1.15;
}

.page-hero p { color: var(--text-muted); margin-top: 10px; }

.card {
  background: linear-gradient(160deg, var(--purple-700), var(--purple-800));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
}

.tag {
  display: inline-block;
  background: var(--red);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 11px;
  border-radius: 999px;
}

.tag-live { background: var(--red); animation: pulse 1.6s infinite; }
.tag-gold { background: var(--gold); color: var(--purple-950); }
.tag-muted { background: rgba(255, 255, 255, 0.14); }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* ---------- Home hero ---------- */
.hero {
  background: radial-gradient(ellipse at 60% 30%, var(--purple-600) 0%, var(--purple-800) 55%, var(--purple-900) 100%);
  padding: 40px 0 70px;
  text-align: center;
}

.hero-image {
  width: 100%;
  max-width: 880px;
  margin: 0 auto;
  border-radius: var(--radius);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
}

.hero-badge {
  display: inline-block;
  margin-top: 30px;
  background: rgba(255, 210, 26, 0.15);
  color: var(--gold);
  border: 1px solid rgba(255, 210, 26, 0.4);
  border-radius: 999px;
  padding: 6px 18px;
  font-weight: 700;
}

.hero-text {
  max-width: 640px;
  margin: 18px auto 30px;
  font-size: 1.15rem;
  color: var(--text-muted);
}

.hero-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ---------- Problem / solution ---------- */
.ps-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.ps-card h3 {
  font-size: 1.4rem;
  font-weight: 800;
  margin-bottom: 10px;
}

.ps-card p { color: var(--text-muted); }
.ps-card.problem h3 { color: #ff8a80; }
.ps-card.solution { border-color: var(--gold); }
.ps-card.solution h3 { color: var(--gold); }

.league-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.league-pill {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  padding: 6px 16px;
  font-weight: 700;
}

/* ---------- Sport tabs ---------- */
.sport-tabs {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 28px;
}

.sport-tab {
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
  border: 2px solid transparent;
  border-radius: 999px;
  padding: 10px 22px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}

.sport-tab:hover { background: rgba(255, 255, 255, 0.15); }

.sport-tab.active {
  background: var(--gold);
  color: var(--purple-950);
}

/* ---------- Analyzer ---------- */
.analyzer {
  background: var(--purple-950);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

.scoreboard {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 18px 24px;
  background: linear-gradient(90deg, var(--purple-800), var(--purple-700), var(--purple-800));
}

.team { display: flex; flex-direction: column; }
.team.home { align-items: flex-end; text-align: right; }

.team-name { font-weight: 800; font-size: 1.05rem; }
.team-label { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; }

.score {
  font-size: 2.2rem;
  font-weight: 900;
  color: var(--gold);
  padding: 0 18px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.score.bump { animation: bump 0.5s; }

@keyframes bump {
  40% { transform: scale(1.25); color: var(--white); }
}

.game-clock {
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
  padding: 6px;
  background: rgba(0, 0, 0, 0.25);
}

/* Field strip with the ball sliding to the win probability */
.field {
  position: relative;
  height: 90px;
  margin: 16px 20px 6px;
  border-radius: 12px;
  overflow: hidden;
}

.field.nfl { background: repeating-linear-gradient(90deg, #1f7a34 0 9.5%, #fff3 9.5% 10%), #1f7a34; }
.field.mlb { background: radial-gradient(circle at 50% 120%, #c58a4a 0 35%, #2c8a3e 35%); }
.field.nba { background: repeating-linear-gradient(90deg, #c98d4f 0 6%, #b97c40 6% 12%); }
.field.nhl { background: linear-gradient(90deg, #eaf4ff 0 33%, #2563eb 33% 33.6%, #eaf4ff 33.6% 49.7%, #dc2626 49.7% 50.3%, #eaf4ff 50.3% 66.4%, #2563eb 66.4% 67%, #eaf4ff 67%); }

.field-ball {
  position: absolute;
  top: 50%;
  left: 50%;
  font-size: 2rem;
  transform: translate(-50%, -50%);
  transition: left 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.5));
}

.field-ball.hit { animation: spin 0.8s; }

@keyframes spin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.winprob {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  color: var(--text-muted);
  padding: 0 22px 12px;
}

.winprob strong { color: var(--white); }

.feed {
  list-style: none;
  max-height: 360px;
  overflow-y: auto;
  padding: 6px 20px 20px;
}

.feed-item {
  border-left: 3px solid var(--gold);
  padding: 10px 14px;
  margin-top: 12px;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 0 10px 10px 0;
  animation: slideIn 0.4s ease-out;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-16px); }
}

.feed-time { font-size: 0.75rem; color: var(--gold); font-weight: 700; }
.feed-text { font-weight: 600; }

.feed-text.typing::after {
  content: "|";
  animation: blink 0.8s infinite;
  color: var(--gold);
}

@keyframes blink { 50% { opacity: 0; } }

.feed-note {
  margin-top: 6px;
  font-size: 0.9rem;
  color: var(--text-muted);
  opacity: 0;
  transition: opacity 0.5s;
}

.feed-note.show { opacity: 1; }

.feed-note b { color: var(--gold); }

.analyzer-controls {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  padding: 0 20px 18px;
}

/* ---------- Forms ---------- */
.form-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }

.form-field label { font-weight: 600; font-size: 0.9rem; }

.input {
  padding: 13px 18px;
  border-radius: 12px;
  border: 2px solid transparent;
  font: inherit;
  outline: none;
  background: var(--white);
  color: var(--purple-950);
}

.input:focus { border-color: var(--gold); }

.form-message { min-height: 1.6em; margin-top: 10px; color: var(--gold); text-align: center; }
.form-message.error { color: #ff8a80; }

/* ---------- Sign in ---------- */
.auth-wrap {
  max-width: 440px;
  margin: 0 auto;
}

.auth-card { padding: 36px; }

.auth-card img { width: 72px; margin: 0 auto 14px; border-radius: 16px; }

.auth-card h1 {
  text-align: center;
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--gold);
}

.auth-card .sub { text-align: center; color: var(--text-muted); margin-bottom: 24px; }

.social-btn {
  width: 100%;
  margin-bottom: 12px;
  background: var(--white);
  color: #111;
}

.social-btn.apple { background: #000; color: var(--white); }

.social-btn svg { width: 20px; height: 20px; }

.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text-muted);
  font-size: 0.85rem;
  margin: 18px 0;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--border);
}

.auth-switch { text-align: center; margin-top: 18px; color: var(--text-muted); }
.auth-switch button { background: none; border: none; color: var(--gold); font-weight: 700; cursor: pointer; }

/* ---------- Analytics page ---------- */
.account-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  padding: 14px 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 28px;
}

.account-bar a { color: var(--gold); font-weight: 700; }

.analytics-layout {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 24px;
  align-items: start;
}

.panel-title {
  font-size: 1.1rem;
  font-weight: 800;
  margin: 0 0 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.game-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px; }

.game-item {
  width: 100%;
  text-align: left;
  background: var(--purple-800);
  border: 2px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  color: var(--white);
  cursor: pointer;
  transition: border-color 0.2s;
}

.game-item:hover { border-color: rgba(255, 210, 26, 0.5); }
.game-item.selected { border-color: var(--gold); }
.game-item[disabled] { cursor: default; opacity: 0.85; }
.game-item[disabled]:hover { border-color: var(--border); }

.game-item .row { display: flex; justify-content: space-between; gap: 10px; }
.game-item .teams { font-weight: 700; }
.game-item .meta { font-size: 0.82rem; color: var(--text-muted); margin-top: 4px; }

.empty { color: var(--text-muted); font-size: 0.9rem; }

.analyzer-empty {
  display: grid;
  place-items: center;
  text-align: center;
  min-height: 360px;
  color: var(--text-muted);
  padding: 30px;
}

.analyzer-empty .big { font-size: 3rem; }

.past-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}

.past-card { padding: 20px; cursor: pointer; transition: transform 0.2s, border-color 0.2s; text-align: left; color: var(--white); width: 100%; }
.past-card:hover { transform: translateY(-3px); border-color: var(--gold); }
.past-card .final { font-size: 1.5rem; font-weight: 900; color: var(--gold); margin: 6px 0; }
.past-card .meta { color: var(--text-muted); font-size: 0.85rem; }

/* ---------- Chatbot ---------- */
.chat-fab {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 200;
  width: 62px;
  height: 62px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(180deg, var(--gold), var(--gold-dark));
  font-size: 1.7rem;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.chat-panel {
  position: fixed;
  right: 22px;
  bottom: 96px;
  z-index: 200;
  width: min(380px, calc(100vw - 32px));
  height: min(520px, calc(100vh - 140px));
  display: none;
  flex-direction: column;
  background: var(--purple-950);
  border: 1px solid var(--gold);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
}

.chat-panel.open { display: flex; }

.chat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  background: var(--purple-700);
  font-weight: 800;
}

.chat-head button { background: none; border: none; color: var(--white); font-size: 1.3rem; cursor: pointer; }

.chat-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }

.msg { max-width: 85%; padding: 10px 14px; border-radius: 14px; font-size: 0.92rem; }
.msg.bot { background: var(--purple-700); align-self: flex-start; border-bottom-left-radius: 4px; }
.msg.user { background: var(--gold); color: var(--purple-950); align-self: flex-end; border-bottom-right-radius: 4px; font-weight: 600; }

.chat-suggestions { display: flex; gap: 6px; flex-wrap: wrap; padding: 0 16px 10px; }
.chat-suggestions button {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border);
  color: var(--white);
  border-radius: 999px;
  padding: 5px 12px;
  font-size: 0.8rem;
  cursor: pointer;
}

.chat-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border); }
.chat-form .input { flex: 1; padding: 10px 14px; }

/* ---------- Who we are ---------- */
.team-card { text-align: center; }

.avatar {
  width: 110px;
  height: 110px;
  margin: 0 auto 16px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 2.4rem;
  font-weight: 900;
  color: var(--purple-950);
  background: linear-gradient(160deg, var(--gold), var(--gold-dark));
  border: 4px solid var(--purple-950);
  box-shadow: 0 0 0 3px var(--gold);
}

.team-card h3 { font-size: 1.3rem; }
.team-card .role { color: var(--gold); font-weight: 700; margin-bottom: 8px; }
.team-card p { color: var(--text-muted); font-size: 0.95rem; }

/* ---------- Legal ---------- */
.legal { max-width: 820px; margin: 0 auto; }
.legal-nav { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 30px; }
.legal h2 { color: var(--gold); font-size: 1.5rem; margin: 40px 0 10px; }
.legal h3 { font-size: 1.1rem; margin: 22px 0 6px; }
.legal p, .legal li { color: var(--text-muted); }
.legal ul { padding-left: 22px; margin: 8px 0; }
.legal .updated { text-align: center; color: var(--text-muted); font-size: 0.9rem; }

/* ---------- CTA ---------- */
.cta {
  text-align: center;
  background: linear-gradient(135deg, var(--purple-600), var(--purple-800));
}

.cta p { color: var(--text-muted); margin-bottom: 26px; font-size: 1.1rem; }

/* ---------- Footer ---------- */
.site-footer {
  background: var(--purple-950);
  padding: 40px 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.site-footer .brand { justify-content: center; margin-bottom: 10px; }
.footer-links { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin: 12px 0; }
.footer-links a:hover { color: var(--gold); }

.demo-note { font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-top: 14px; }

/* ---------- Mobile ---------- */
@media (max-width: 900px) {
  .nav-toggle { display: block; }

  .nav-menu {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--purple-900);
    border-bottom: 2px solid var(--gold);
    display: none;
    padding-bottom: 16px;
  }

  .nav-menu.open { display: flex; }
  .nav-links { flex-direction: column; gap: 0; }
  .nav-links a { display: block; padding: 14px 20px; }
  .nav-actions { padding: 8px 20px 0; }

  .ps-grid,
  .analytics-layout { grid-template-columns: 1fr; }
}

@media (max-width: 520px) {
  section { padding: 56px 0; }
  .score { font-size: 1.6rem; padding: 0 8px; }
  .team-name { font-size: 0.9rem; }
  .auth-card { padding: 26px 20px; }
}
