/*
  KnockOut Assistant: same rule-based answers as website/js/chatbot.js.
  To make it smarter, send the question plus the current game's plays to an
  AI model from your own backend (never ship an API key inside the app).
*/
import { KO_DATA } from "./data";

export function koChatAnswer(question, { game, index = 0, sport = "all" }) {
  const q = question.toLowerCase();
  const play = game && index > 0 ? game.plays[index - 1] : null;
  const has = (...words) => words.some(w => q.includes(w));

  if (/^(hi|hey|hello|yo|sup)\b/.test(q)) {
    return "Hey! Pick a game from Live Now, then ask me anything about it.";
  }

  const term = KO_DATA.glossary.find(entry => entry.words.some(w => q.includes(w)));
  if (term && !has("score", "winning", "just happened", "last play")) return term.def;

  if (has("score")) {
    if (!play) return "Open a game first and I'll tell you the score.";
    const s = [...game.plays.slice(0, index)].reverse().find(p => p.s) || { s: [0, 0] };
    return `${game.away} ${s.s[0]}, ${game.home} ${s.s[1]} (${play.t}).`;
  }

  if (has("winning", "win", "favorite", "favored", "chance")) {
    if (!play) return "Open a game first and I'll show you each team's chances.";
    const leader = play.p >= 50 ? game.home : game.away;
    const pct = play.p >= 50 ? play.p : 100 - play.p;
    return `Right now ${leader} has about a ${pct}% chance to win, based on the score, time left and game situation.`;
  }

  if (has("happened", "last play", "explain", "why", "what was that", "mean")) {
    if (!play) return "Pick a live game and I'll explain each play as it happens.";
    return `${play.text} ${play.note}`;
  }

  if (has("upcoming", "next game", "schedule", "when")) {
    const list = KO_DATA.upcoming.filter(g => sport === "all" || g.sport === sport).slice(0, 3);
    if (!list.length) return "There are no upcoming games for this sport right now.";
    return "Coming up: " + list.map(g => `${g.away} @ ${g.home} (${g.when})`).join("; ") + ".";
  }

  if (has("nfl", "football")) return "The NFL is American football: 4 quarters of 15 minutes. Teams score with touchdowns (6), extra points (1 or 2) and field goals (3).";
  if (has("mlb", "baseball")) return "MLB is baseball: 9 innings. Each team bats until it makes 3 outs, and runs score when a runner touches home plate.";
  if (has("nba", "basketball")) return "The NBA is basketball: 4 quarters of 12 minutes. Baskets are worth 2 or 3 points, and free throws are worth 1.";
  if (has("nhl", "hockey")) return "The NHL is ice hockey: 3 periods of 20 minutes. Each goal is worth 1 point.";

  return "I'm not sure about that one yet. Try asking \"what just happened?\", \"what's the score?\", or about a term like \"first down\", \"double play\", \"shot clock\" or \"icing\".";
}

/*
  App-wide state: language, signed-in user and saved analyses.
  Everything is stored on the device with AsyncStorage.

  Sign-in is demo only: it stores a name and email, never a password.
  Before launch, connect a real provider:
    - Google: expo-auth-session (Google provider)
    - Apple: expo-apple-authentication
    - Email + password: your backend or Firebase Auth / Supabase
*/
import React, { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { KO_STRINGS } from "./strings";

const AppContext = createContext(null);

const KEYS = { lang: "ko.lang", user: "ko.user", history: "ko.history" };

async function load(key, fallback) {
  try {
    const raw = await AsyncStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch (e) {
    return fallback;
  }
}

function save(key, value) {
  AsyncStorage.setItem(key, JSON.stringify(value)).catch(() => {});
}

export function AppProvider({ children }) {
  const [lang, setLangState] = useState("en");
  const [user, setUser] = useState(null);
  const [history, setHistory] = useState({});
  const [ready, setReady] = useState(false);

  useEffect(() => {
    (async () => {
      const savedLang = await load(KEYS.lang, "en");
      setLangState(KO_STRINGS[savedLang] ? savedLang : "en");
      setUser(await load(KEYS.user, null));
      setHistory(await load(KEYS.history, {}));
      setReady(true);
    })();
  }, []);

  const t = useCallback(
    key => (KO_STRINGS[lang] && KO_STRINGS[lang][key]) || KO_STRINGS.en[key] || key,
    [lang]
  );

  const setLang = useCallback(code => {
    setLangState(code);
    save(KEYS.lang, code);
  }, []);

  const signIn = useCallback(profile => {
    setUser(profile);
    save(KEYS.user, profile);
  }, []);

  const signOut = useCallback(() => {
    setUser(null);
    AsyncStorage.removeItem(KEYS.user).catch(() => {});
  }, []);

  // Saves the lines the analyzer has shown so far, for signed-in users.
  const saveAnalysis = useCallback(
    (game, count) => {
      if (!user) return;
      setHistory(prev => {
        const next = {
          ...prev,
          [game.id]: {
            id: game.id,
            sport: game.sport,
            away: game.away,
            home: game.home,
            date: new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" }),
            saved: true,
            plays: game.plays.slice(0, count)
          }
        };
        save(KEYS.history, next);
        return next;
      });
    },
    [user]
  );

  const value = useMemo(
    () => ({ ready, lang, setLang, t, user, signIn, signOut, history, saveAnalysis }),
    [ready, lang, setLang, t, user, signIn, signOut, history, saveAnalysis]
  );

  return <AppContext.Provider value={value}>{children}</AppContext.Provider>;
}

export function useApp() {
  return useContext(AppContext);
}

