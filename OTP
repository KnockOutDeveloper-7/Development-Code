<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | KnockOut</title>
  <link rel="icon" type="image/webp" href="images/favicon.webp">
  <link rel="apple-touch-icon" href="images/favicon.webp">
  <meta name="theme-color" content="#2a0fa8">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body data-page="signin">
  <header id="site-header"></header>

  <main class="page-hero" style="padding-bottom: 80px;">
    <div class="container auth-wrap">
      <div class="card auth-card">
        <img src="images/favicon.webp" alt="KnockOut">
        <h1 data-i18n="si.title"></h1>
        <p class="sub" id="auth-sub" data-i18n="si.sub"></p>

        <button class="btn social-btn" id="google-btn" type="button">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          <span data-i18n="si.google"></span>
        </button>
        <button class="btn social-btn apple" id="apple-btn" type="button">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 1.43c0 1.14-.42 2.2-1.1 2.98-.82.95-2.06 1.6-3.13 1.52-.13-1.1.42-2.25 1.08-2.97.76-.86 2.08-1.5 3.15-1.53zM20.5 17.3c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.5-4.12 3.51-1.54.02-1.94-1-4.03-.99-2.09.01-2.53 1.01-4.07.99-1.73-.02-3.05-1.77-4.04-3.33C-.07 16.07-.36 10.95 1.4 8.26c1.25-1.91 3.22-3.03 5.08-3.03 1.89 0 3.08 1.04 4.64 1.04 1.52 0 2.44-1.04 4.63-1.04 1.65 0 3.4.9 4.65 2.45-4.08 2.24-3.42 8.07.1 9.62z"/></svg>
          <span data-i18n="si.apple"></span>
        </button>

        <div class="divider" data-i18n="si.or"></div>

        <form id="auth-form" novalidate>
          <div class="form-field" id="name-field" hidden>
            <label for="name" data-i18n="si.name"></label>
            <input class="input" id="name" name="name" autocomplete="name">
          </div>
          <div class="form-field">
            <label for="email" data-i18n="si.email"></label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="form-field">
            <label for="password" data-i18n="si.password"></label>
            <input class="input" id="password" name="password" type="password" autocomplete="current-password" minlength="8" required>
          </div>
          <button class="btn btn-primary" style="width: 100%;" type="submit" id="submit-btn" data-i18n="si.submit"></button>
          <p class="form-message" id="auth-message" role="alert"></p>
        </form>

        <p class="auth-switch">
          <span id="switch-text" data-i18n="si.noAccount"></span>
          <button type="button" id="switch-btn" data-i18n="si.signupLink"></button>
        </p>
        <p class="demo-note"><a href="privacy.html" data-i18n="si.agree"></a></p>
      </div>
    </div>
  </main>

  <footer id="site-footer"></footer>

  <script src="js/i18n.js"></script>
  <script src="js/main.js"></script>
  <script>
    /*
      Demo sign-in. Google, Apple and email buttons all "sign in" locally so the
      rest of the site can be tested. To go live, connect a real auth service:
        - Google: Google Identity Services
        - Apple: Sign in with Apple JS
        - Email + password: your backend or a provider like Firebase Auth
    */
    document.addEventListener("DOMContentLoaded", () => {
      let signup = new URLSearchParams(location.search).get("mode") === "signup";
      const form = document.getElementById("auth-form");
      const msg = document.getElementById("auth-message");

      function setMode() {
        document.getElementById("name-field").hidden = !signup;
        document.getElementById("password").autocomplete = signup ? "new-password" : "current-password";
        const pairs = [
          ["auth-sub", signup ? "si.subUp" : "si.sub"],
          ["submit-btn", signup ? "si.create" : "si.submit"],
          ["switch-text", signup ? "si.haveAccount" : "si.noAccount"],
          ["switch-btn", signup ? "si.signinLink" : "si.signupLink"]
        ];
        pairs.forEach(([id, key]) => { document.getElementById(id).dataset.i18n = key; });
        koApplyLang();
        msg.textContent = "";
      }

      function finish(user) {
        koAuth.set(user);
        window.location.href = "analytics.html";
      }

      document.getElementById("switch-btn").addEventListener("click", () => {
        signup = !signup;
        setMode();
      });

      document.getElementById("google-btn").addEventListener("click", () =>
        finish({ name: "Google user", email: "", method: "google" }));

      document.getElementById("apple-btn").addEventListener("click", () =>
        finish({ name: "Apple user", email: "", method: "apple" }));

      form.addEventListener("submit", e => {
        e.preventDefault();
        const email = form.email.value.trim();
        const password = form.password.value;
        msg.classList.add("error");

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.textContent = "Please enter a valid email address.";
          return;
        }
        if (password.length < 8) {
          msg.textContent = "Password must be at least 8 characters.";
          return;
        }

        const name = (signup && form.name.value.trim()) || email.split("@")[0];
        finish({ name, email, method: "email" });
      });

      setMode();
    });
  </script>
</body>
</html>
